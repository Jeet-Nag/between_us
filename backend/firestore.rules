rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the caller is an authenticated Firebase user
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    // Check if the authenticated user is a verified member of the couple
    function isCoupleMember(coupleId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/couples/$(coupleId)) &&
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    // Couple root documents
    match /couples/{coupleId} {
      // Allow reading if user is an existing member OR during initial code pairing lookup
      allow get: if isAuthenticated() && (
        (resource.data.members != null && resource.data.members.hasAny([request.auth.uid])) ||
        (resource.data.status == 'waitingForPartner')
      );
      
      // Query waiting couples strictly by pairingCode or list user member couples
      allow list: if isAuthenticated() && (
        resource.data.status == 'waitingForPartner' ||
        (resource.data.members != null && resource.data.members.hasAny([request.auth.uid]))
      );
      
      // Allow creation of a new space: creator must be in the initial members array and members <= 2
      allow create: if isAuthenticated() &&
        request.resource.data.members != null &&
        request.resource.data.members.hasAny([request.auth.uid]) &&
        request.resource.data.members.size() >= 1 &&
        request.resource.data.members.size() <= 2;
      
      // Allow updates by existing members OR by joining partner during pairing handshake
      allow update: if isCoupleMember(coupleId) || (
        isAuthenticated() && 
        resource.data.status == 'waitingForPartner' &&
        request.resource.data.members != null &&
        request.resource.data.members.hasAll(resource.data.members) &&
        request.resource.data.members.size() == 2 &&
        request.resource.data.members.hasAny([request.auth.uid])
      );
      
      // Only existing couple members can delete the space
      allow delete: if isCoupleMember(coupleId);

      // Private Subcollections: locations, messages, moments, music, memories, presence
      // Strictly accessible ONLY by verified couple members
      match /{subCollection}/{document=**} {
        allow read, write: if isCoupleMember(coupleId);
      }
    }
    
    // User profile documents (FCM device tokens, display names)
    // Strictly private: A user can ONLY read and write their OWN profile document
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
