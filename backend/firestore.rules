rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the caller is an authenticated Firebase user
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    // Check if the authenticated user is a verified member of the couple
    function isCoupleMember(coupleId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/couples/$(coupleId)) &&
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    // 1. Invitations Collection: O(1) Keyed Lookups Only (Zero Enumeration)
    match /invitations/{code} {
      // Completely disallow collection listing / enumeration
      allow list: if false;

      // Allow get ONLY by exact code if active or if creator
      allow get: if isAuthenticated() && (
        resource.data.status == 'active' ||
        resource.data.creatorId == request.auth.uid
      );

      // Creator can create invitation
      allow create: if isAuthenticated() &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.status == 'active' &&
        request.resource.data.code == code &&
        request.resource.data.coupleId != null;

      // Update: only claiming partner (cannot be creator) during handshake or creator deactivating
      allow update: if isAuthenticated() && (
        (
          resource.data.status == 'active' &&
          request.resource.data.status == 'claimed' &&
          request.auth.uid != resource.data.creatorId &&
          request.resource.data.claimedBy == request.auth.uid &&
          request.resource.data.claimedBy != resource.data.creatorId &&
          request.resource.data.code == resource.data.code &&
          request.resource.data.coupleId == resource.data.coupleId &&
          request.resource.data.creatorId == resource.data.creatorId
        ) ||
        (resource.data.creatorId == request.auth.uid)
      );

      // Delete: only creator
      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }

    // 2. Couples Collection: Strictly Protected Intimate Spaces
    match /couples/{coupleId} {
      // Reading /couples/{coupleId}: ONLY existing members can read
      allow get: if isAuthenticated() &&
        resource.data.members != null &&
        resource.data.members.hasAny([request.auth.uid]);
      
      // Listing /couples: ONLY own memberships
      allow list: if isAuthenticated() &&
        resource.data.members != null &&
        resource.data.members.hasAny([request.auth.uid]);
      
      // Creating space: creator must be the sole initial member
      allow create: if isAuthenticated() &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.members != null &&
        request.resource.data.members == [request.auth.uid] &&
        request.resource.data.status == 'waitingForPartner';
      
      // Updating space: existing members OR joining partner (cannot be creator) during atomic transaction
      allow update: if isAuthenticated() && (
        // Existing members updating (e.g. countdown, settings)
        (resource.data.members != null && resource.data.members.hasAny([request.auth.uid])) ||
        // Joining partner claiming the space
        (
          resource.data.status == 'waitingForPartner' &&
          resource.data.members.size() == 1 &&
          request.auth.uid != resource.data.creatorId &&
          !resource.data.members.hasAny([request.auth.uid]) &&
          request.resource.data.members.size() == 2 &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.hasAny([request.auth.uid]) &&
          request.resource.data.status == 'connected' &&
          request.resource.data.creatorId == resource.data.creatorId &&
          request.resource.data.pairingCode == resource.data.pairingCode
        )
      );
      
      allow delete: if isCoupleMember(coupleId);

      // Subcollections with user-scoped write constraints
      match /locations/{userId} {
        allow read: if isCoupleMember(coupleId);
        allow write: if isCoupleMember(coupleId) && request.auth.uid == userId;
      }

      match /presence/{userId} {
        allow read: if isCoupleMember(coupleId);
        allow write: if isCoupleMember(coupleId) && request.auth.uid == userId;
      }

      // Other intimate subcollections: messages, moments, music, memories
      match /{subCollection}/{document=**} {
        allow read, write: if isCoupleMember(coupleId);
      }
    }
    
    // User profile documents (FCM device tokens, display names)
    // A user can read their own profile, or their verified paired partner can read their profile
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (
          resource.data.coupleId != null &&
          isCoupleMember(resource.data.coupleId)
        )
      );
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
